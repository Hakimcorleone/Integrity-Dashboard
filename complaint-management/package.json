{
  "name": "integrity-complaint-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && wrangler deploy --dry-run --env preview --outdir dist-worker",
    "preview": "wrangler dev",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply integrity-complaints-preview --local",
    "db:migrate:preview": "wrangler d1 migrations apply integrity-complaints-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply integrity-complaints-production --remote --env production",
    "db:seed:preview": "wrangler d1 execute integrity-complaints-preview --remote --env preview --file seed/preview.sql && wrangler d1 execute integrity-complaints-preview --remote --env preview --file seed/preview-demo.sql",
    "deploy:preview": "pnpm build && wrangler deploy --env preview",
    "deploy:production": "pnpm build && wrangler deploy --env production",
    "cf-types": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.7.0"
}
