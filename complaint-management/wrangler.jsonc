{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "integrity-complaints",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "integrity-complaints-preview",
      "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "integrity-evidence-preview"
    }
  ],
  "vars": {
    "ENVIRONMENT": "preview",
    "APP_NAME": "Integrity Case Management",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "MAX_UPLOAD_BYTES": "10485760",
    "ALLOWED_EMAIL_DOMAIN": "example.invalid",
    "NOTIFICATION_PROVIDER": "in-app"
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "env": {
    "preview": {
      "name": "integrity-complaints-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "integrity-complaints-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EVIDENCE",
          "bucket_name": "integrity-evidence-preview"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "APP_NAME": "Integrity Case Management (Preview)",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "MAX_UPLOAD_BYTES": "10485760",
        "ALLOWED_EMAIL_DOMAIN": "example.invalid",
        "NOTIFICATION_PROVIDER": "in-app"
      },
      "triggers": { "crons": ["0 0 * * *"] }
    },
    "production": {
      "name": "integrity-complaints-production",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "integrity-complaints-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EVIDENCE",
          "bucket_name": "integrity-evidence-production"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_NAME": "Integrity Case Management",
        "TURNSTILE_SITE_KEY": "REPLACE_WITH_PRODUCTION_TURNSTILE_SITE_KEY",
        "MAX_UPLOAD_BYTES": "10485760",
        "ALLOWED_EMAIL_DOMAIN": "REPLACE_WITH_AUTHORISED_DOMAIN",
        "NOTIFICATION_PROVIDER": "in-app"
      },
      "triggers": { "crons": ["0 0 * * *"] }
    }
  }
}
